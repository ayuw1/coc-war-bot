# Example .env for coc-war-bot
# Copy this file to `.env` and fill in your real values.
# Do NOT commit the resulting `.env` file with your secrets.

# Clash of Clans API token from https://developer.clashofclans.com/
COC_API_TOKEN=

# Clan tag (with or without leading #). Example: #ABCD123 or ABCD123
CLAN_TAG=

# Check interval in seconds (default: 60)
CHECK_INTERVAL=60

# Maximum number of attack log lines to include in output
MAX_LOG_LINES=30

# Toggle sections on/off (true / false)
SHOW_MEMBER_DETAILS=true
SHOW_ATTACK_LOG=true

# Telegram: only send notification when war state changes
TELEGRAM_NOTIFY_ON_STATE_CHANGE=true

# NEW: send initial war summary once on startup (useful for testing Telegram)
# Set to true to force sending the current war summary to Telegram right after the bot starts.
TELEGRAM_SEND_ON_START=false

# Minimum number of attacks for a member to be considered 'active'
MIN_ATTACKS_TO_BE_ACTIVE=1

# Telegram bot token and chat id (optional). Required only if you want notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
